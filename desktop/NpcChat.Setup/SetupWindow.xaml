<Window x:Class="NpcChat.Setup.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="NPC Chat 설치" Width="740" Height="650" MinWidth="620" MinHeight="540" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="#FFFFFF" Foreground="#302440" Topmost="False" Icon="Assets/brand.png" FontFamily="Segoe UI, Malgun Gothic">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#F1EAFF"/><Setter Property="Foreground" Value="#674394"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="40"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#AC86FF"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/><Setter Property="Width" Value="44"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="17"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="RadioButton"><Setter Property="Margin" Value="0,7,0,7"/><Setter Property="FontSize" Value="13"/></Style>
 </Window.Resources>
 <Border BorderBrush="#E5DCF1" BorderThickness="1"><Grid x:Name="Frame">
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Background="#FAF7FF"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,100,0"><Image Source="Assets/brand.png" Width="23" Height="23"/><TextBlock Text="NPC Chat  ·  설치" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="−" Click="Minimize" ToolTip="최소화" AutomationProperties.Name="최소화"/><Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Content="×" Click="CloseSetup" ToolTip="닫기" AutomationProperties.Name="닫기"/></StackPanel></Grid>
  <Grid Grid.Row="1" Margin="32,23,32,18"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="Assets/brand.png" Width="56" Height="56" HorizontalAlignment="Left"/><StackPanel Grid.Column="1"><TextBlock x:Name="Heading" Text="나만의 대화 공간을 준비해요" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Text="설치 위치와 옵션을 선택하면 나머지는 준비해 드릴게요." Foreground="#82718F" FontSize="12" Margin="0,7,0,0"/></StackPanel></Grid>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32,0,32,20">
   <Border Background="#F7F3FF" CornerRadius="12" Padding="16,12" Margin="0,0,0,21"><TextBlock x:Name="Steps" Text="01  설치 설정       →       02  파일 설치       →       03  완료" Foreground="#7445BD" FontSize="12" FontWeight="SemiBold"/></Border>
   <StackPanel x:Name="OptionsPanel">
    <TextBlock Text="설치 위치" FontSize="13" FontWeight="SemiBold"/>
    <Grid Margin="0,9,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><Border CornerRadius="9" BorderBrush="#DFD3EF" BorderThickness="1" Padding="10,9" Margin="0,0,8,0"><TextBox x:Name="InstallPath" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="12" AutomationProperties.Name="설치 위치"/></Border><Button x:Name="BrowseButton" Grid.Column="1" Content="찾아보기" Click="Browse" FontSize="12"/></Grid>
    <TextBlock Text="프로그램 전용 폴더를 선택해 주세요. 기존 대화와 기억은 보존합니다." Foreground="#82718F" FontSize="11"/>
    <TextBlock Text="설치 파일 준비" FontSize="13" FontWeight="SemiBold" Margin="0,18,0,2"/>
    <RadioButton x:Name="LocalSource" GroupName="Source" Content="동봉된 앱과 모델 사용 · 추가 다운로드 없음"/>
    <RadioButton x:Name="OnlineSource" GroupName="Source" Content="앱과 모델 다운로드 · 인터넷 연결 필요"/>
    <TextBlock x:Name="SourceNote" Foreground="#82718F" FontSize="11" Margin="0,2,0,13"/>
    <CheckBox x:Name="DesktopShortcut" Content="바탕화면에 바로가기 만들기" IsChecked="True" FontSize="13" Margin="0,6,0,10"/>
    <TextBlock x:Name="SpaceNote" Foreground="#82718F" FontSize="11"/>
   </StackPanel>
   <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
    <TextBlock x:Name="Phase" Text="설치 준비 중" FontSize="19" FontWeight="SemiBold"/>
    <ProgressBar x:Name="Bar" Height="8" Margin="0,20,0,12" Foreground="#7434FF" Background="#EEE5FF" Minimum="0" Maximum="100"/>
    <TextBlock x:Name="ProgressDetail" Foreground="#82718F" FontSize="12"/>
    <TextBlock Text="파일을 확인하고 안전하게 설치합니다. 검증 단계는 잠시 걸릴 수 있어요." Foreground="#82718F" FontSize="12" Margin="0,24,0,0"/>
   </StackPanel>
   <StackPanel x:Name="DonePanel" Visibility="Collapsed">
    <TextBlock Text="준비가 끝났어요!" FontSize="23" FontWeight="SemiBold" Foreground="#7434FF" Margin="0,10,0,12"/>
    <TextBlock x:Name="DonePath" Foreground="#82718F" FontSize="12"/>
    <CheckBox x:Name="LaunchAfter" Content="완료 후 NPC Chat 실행" IsChecked="True" Margin="0,24,0,12" FontSize="14"/>
    <Button Content="설치 폴더 열기" HorizontalAlignment="Left" Click="OpenFolder" FontSize="12"/>
   </StackPanel>
   <Border x:Name="StatusBox" Background="#F8F4FF" CornerRadius="10" Padding="12" Margin="0,15,0,0" Visibility="Collapsed"><TextBlock x:Name="Status" FontSize="12" Foreground="#79539A" AutomationProperties.LiveSetting="Polite"/></Border>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="3" BorderBrush="#EEE7F7" BorderThickness="0,1,0,0" Padding="32,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Windows x64 · 내부 시험판&#10;기존 대화 데이터는 삭제하지 않습니다." Foreground="#93839F" FontSize="10" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelButton" Content="닫기" Click="Cancel" Margin="0,0,10,0"/><Button x:Name="PrimaryButton" Content="설치 시작" Background="#7434FF" Foreground="White" Click="Primary" MinWidth="115"/></StackPanel></Grid></Border>
 </Grid></Border>
</Window>
