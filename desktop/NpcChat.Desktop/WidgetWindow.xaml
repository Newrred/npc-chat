<Window x:Class="NpcChat.Desktop.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NPC Chat 위젯" Width="190" Height="282" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False">
 <Border Margin="8" CornerRadius="26" Background="#FFF9F2" BorderBrush="#E5D6C7" BorderThickness="1">
  <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="132"/><RowDefinition Height="25"/><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="DragHeader"><TextBlock Text="함께 있는 시간" FontSize="10" Foreground="#94735F" VerticalAlignment="Center"/>
    <Button HorizontalAlignment="Right" Content="⋯" Padding="5,0" Background="Transparent" BorderThickness="0" Click="OpenMenu" ToolTip="위젯 메뉴"/>
   </Grid>
   <Border Grid.Row="1" CornerRadius="65" Width="130" Height="130" Background="#EBDCD0" ClipToBounds="True">
    <Image x:Name="Portrait" Stretch="UniformToFill" MouseLeftButtonUp="OpenChat"><Image.Clip><EllipseGeometry Center="65,65" RadiusX="65" RadiusY="65"/></Image.Clip></Image>
   </Border>
   <TextBlock x:Name="CharacterName" Grid.Row="2" Text="유이" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#473B34"/>
   <TextBlock x:Name="Status" Grid.Row="3" Text="준비하고 있어요…" FontSize="10" HorizontalAlignment="Center" Foreground="#88796E" TextTrimming="CharacterEllipsis"/>
   <Button x:Name="ChatButton" Grid.Row="4" Content="대화하기  ↗" Click="OpenChat" IsEnabled="False" Background="#5D7167" Foreground="White" BorderThickness="0" Margin="0,4,0,0"/>
  </Grid>
 </Border>
</Window>
