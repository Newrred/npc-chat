# Local llama.cpp OpenAI-compatible endpoint; backend uses port 8000.
NPC_CHARACTER_ID=default
NPC_LLM_BACKEND=llama_cpp
NPC_BASE_URL=http://127.0.0.1:8001/v1
NPC_API_KEY=my-local-key
# Set this to a model ID served by /v1/models (or your llama.cpp alias).
NPC_MODEL=local-model
NPC_TIMEOUT=120
NPC_TEMP=0.4
NPC_TOP_P=1.0
NPC_TOP_K=20
NPC_PRESENCE_PENALTY=0.5
NPC_FREQUENCY_PENALTY=0.3
NPC_REPETITION_PENALTY=1.08
NPC_MAX_TOKENS=256
NPC_METRICS_ENABLED=0
NPC_METRICS_PATH=.runtime/metrics/requests.jsonl
NPC_METRICS_MAX_BYTES=5000000
NPC_METRICS_BACKUP_COUNT=3
# Per dependency; clamped to 0.1..10 seconds, probes run concurrently.
HEALTH_TIMEOUT_SEC=2

# For GitHub Pages frontend access, set exact origin(s), comma-separated.
# Example: CORS_ORIGINS=https://yourid.github.io
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Optional legacy Redis migration only; normal runtime never connects.
SESSION_TTL_SEC=3600
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=npc
REDIS_LOCK_TIMEOUT_SEC=30
REDIS_LOCK_BLOCKING_TIMEOUT_SEC=10

COMFY_ENABLED=false
COMFY_CONNECT=false
# Optional adapter providing /generate; not the stock ComfyUI API.
COMFY_BASE_URL=http://127.0.0.1:8188
COMFY_TIMEOUT=120
COMFY_CHARACTER_ID=npc-default
COMFY_STYLE_VERSION=v1
COMFY_GEN_COOLDOWN_TURNS=10
COMFY_GEN_MAX_PER_MINUTE=3
COMFY_GEN_MAX_INFLIGHT_PER_SESSION=1
COMFY_GEN_BACKOFF_SEC=30
COMFY_FORCE_REGEN_FACES=angry,crying,scared,excited
COMFY_CACHE_TTL_SEC=1800

# Current RTX 3060 Ti trial: 9B Q4_K_M. Set paths in your ignored local .env.
LLAMA_SERVER_PATH=llama-server.exe
LLAMA_MODEL_PATH=
LLAMA_CONTEXT=4096
# Auto-fit for 9B Q4. The preserved fast 4B profile uses context 8192 and GPU all.
LLAMA_GPU_LAYERS=auto
NPC_OUTPUT_CONTRACT=canonical
# Same loaded model: reply JSON, then metadata JSON. Rollback: single_pass.
# Environments without this setting retain the compatible single_pass behavior.
NPC_GENERATION_MODE=two_stage
# schema (llama.cpp), guided_json (compatible vLLM), json, or text. No silent fallback.
NPC_JSON_MODE=schema

# One app worker; local disk only. Not a network share.
NPC_DATABASE_PATH=.runtime/data/npc-chat.sqlite3
NPC_QUEUE_CAPACITY=8
NPC_QUEUE_WAIT_SEC=30

# llama.cpp apply-template/tokenize counts the actual loaded tokenizer.
# Other providers must explicitly use estimate (approximate, not guaranteed).
NPC_TOKEN_COUNT_MODE=llama_cpp

# Local inspector only; opt-in private traces, 1 hour / 100 turns. Restart web to change.
NPC_DEBUG_TRACE=0
