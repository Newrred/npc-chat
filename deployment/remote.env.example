# Copy to an ignored private file. This is NOT a runnable production configuration.
NPC_ACCESS_MODE=guest
# No email login: anyone with the public URL can use the app within the limits.
NPC_GUEST_SECRET=
NPC_ACTIVE_VISITORS=5
NPC_VISITOR_TTL=300
NPC_DAILY_TOTAL=200
NPC_DAILY_VISITOR=30
NPC_PUBLIC_ORIGIN=
# Required only for the optional cloudflare (email-login) mode:
NPC_ACCESS_ISSUER=
NPC_ACCESS_AUDIENCE=
NPC_REQUESTS_PER_MINUTE=20
# Use an absolute persistent path separate from the development database and application releases.
NPC_DATABASE_PATH=
NPC_BASE_URL=http://127.0.0.1:8001/v1
NPC_LLM_BACKEND=llama_cpp
NPC_MODEL=
NPC_API_KEY=
NPC_OUTPUT_CONTRACT=canonical
NPC_JSON_MODE=schema
NPC_TOKEN_COUNT_MODE=llama_cpp
LLAMA_MODEL_PATH=
LLAMA_SERVER_PATH=
LLAMA_CONTEXT=2048
LLAMA_GPU_LAYERS=all
NPC_MAX_TOKENS=256
NPC_TEMP=0.4
NPC_QUEUE_CAPACITY=8
NPC_QUEUE_WAIT_SEC=30
COMFY_ENABLED=false
COMFY_CONNECT=false
